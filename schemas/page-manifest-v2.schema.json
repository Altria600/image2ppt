{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Altria600/image2ppt/blob/main/schemas/page-manifest-v2.schema.json",
  "title": "Image2PPT page manifest v2",
  "type": "object",
  "required": [
    "schema_version",
    "typography_policy",
    "slide",
    "content_box",
    "source",
    "page_strategy",
    "text_inventory",
    "visual_inventory",
    "background_strategy",
    "quality_checks",
    "quality_evidence",
    "text_boxes",
    "shapes",
    "images",
    "asset_provenance"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "typography_policy": {"const": "governed"},
    "slide": {"type": "object"},
    "content_box": {"type": "object"},
    "source": {
      "type": "object",
      "required": ["width_px", "height_px"],
      "properties": {
        "path": {"type": "string"},
        "width_px": {"type": "number", "exclusiveMinimum": 0},
        "height_px": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "page_strategy": {"type": ["string", "object"]},
    "text_inventory": {"type": "array"},
    "visual_inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {
            "enum": ["background", "foreground-asset", "native-structure", "formula"]
          },
          "representation": {
            "enum": [
              "native",
              "asset-sheet-separated",
              "source-preserving-local-cleanup",
              "imagegen",
              "latex-rendered-formula",
              "svg-reconstructed",
              "vector-traced",
              "source-extracted",
              "image-edited"
            ]
          },
          "path": {"type": "string"},
          "source_type": {"$ref": "#/$defs/sourceType"},
          "editability": {"$ref": "#/$defs/editability"},
          "processing_method": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "reason": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "source_box_px": {"$ref": "#/$defs/boxPx"},
          "source_bbox_px": {"$ref": "#/$defs/boxPx"},
          "identity_evidence": {"type": "string", "minLength": 8},
          "source_identity": {"type": "string", "minLength": 8},
          "identity_preserved": {"type": "boolean"},
          "contamination_check": {"$ref": "#/$defs/contaminationCheck"},
          "contamination_checked": {"type": "boolean"},
          "contamination_note": {"type": "string", "minLength": 4},
          "contamination_status": {"enum": ["clean", "passed", "pass", "ok"]}
        },
        "allOf": [
          {
            "if": {
              "not": {
                "anyOf": [
                  {"required": ["source_type"]},
                  {"required": ["editability"]}
                ]
              }
            },
            "then": {"required": ["representation"]}
          },
          {
            "if": {"required": ["processing_method"]},
            "then": {"required": ["reason"]}
          },
          {
            "if": {"required": ["reason"]},
            "then": {"required": ["processing_method"]}
          },
          {
            "if": {
              "required": ["source_type"],
              "properties": {"source_type": {"enum": ["native-object", "svg-reconstructed", "vector-traced", "source-extracted", "image-edited"]}}
            },
            "then": {"required": ["editability"]}
          },
          {
            "if": {"properties": {"source_type": {"const": "native-object"}}, "required": ["source_type"]},
            "then": {"properties": {"editability": {"const": "native-object"}}}
          },
          {
            "if": {"properties": {"source_type": {"const": "svg-reconstructed"}}, "required": ["source_type"]},
            "then": {
              "required": ["path"],
              "properties": {"editability": {"const": "svg-image"}}
            }
          },
          {
            "if": {"properties": {"source_type": {"const": "vector-traced"}}, "required": ["source_type"]},
            "then": {
              "required": ["path"],
              "properties": {"editability": {"const": "svg-image"}}
            }
          },
          {
            "if": {"properties": {"source_type": {"const": "source-extracted"}}, "required": ["source_type"]},
            "then": {
              "required": ["path", "editability"],
              "properties": {"editability": {"enum": ["raster-image", "svg-image"]}}
            }
          }
        ]
      }
    },
    "background_strategy": {"type": "object"},
    "quality_checks": {
      "type": "object",
      "required": [
        "font_size_calibrated",
        "visual_inventory_matched",
        "background_strategy_checked",
        "shape_corner_geometry_checked"
      ],
      "properties": {
        "font_size_calibrated": {"const": true},
        "visual_inventory_matched": {"const": true},
        "background_strategy_checked": {"const": true},
        "shape_corner_geometry_checked": {"const": true}
      }
    },
    "quality_evidence": {
      "type": "object",
      "required": [
        "font_size_calibrated",
        "visual_inventory_matched",
        "background_strategy_checked",
        "shape_corner_geometry_checked"
      ],
      "additionalProperties": {
        "type": "object",
        "required": ["observation"],
        "properties": {
          "observation": {"type": "string", "minLength": 12},
          "artifact": {"type": "string"}
        }
      }
    },
    "text_boxes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text_style_id": {"type": "string", "minLength": 1},
          "alignment_group": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1}
        }
      }
    },
    "shapes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text_style_id": {"type": "string", "minLength": 1},
          "alignment_group": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1}
        }
      }
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "source_type": {"$ref": "#/$defs/sourceType"},
          "editability": {"$ref": "#/$defs/editability"},
          "processing_method": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "reason": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "source_box_px": {"$ref": "#/$defs/boxPx"},
          "source_bbox_px": {"$ref": "#/$defs/boxPx"}
        },
        "allOf": [
          {"if": {"required": ["processing_method"]}, "then": {"required": ["reason"]}},
          {"if": {"required": ["reason"]}, "then": {"required": ["processing_method"]}},
          {
            "if": {"required": ["source_type"], "properties": {"source_type": {"enum": ["native-object", "svg-reconstructed", "vector-traced", "source-extracted", "image-edited"]}}},
            "then": {"required": ["editability"]}
          }
        ]
      }
    },
    "asset_provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "source_type": {"$ref": "#/$defs/sourceType"},
          "editability": {"$ref": "#/$defs/editability"},
          "producer": {"type": ["string", "null"]},
          "model": {"type": ["string", "null"]},
          "transform": {"type": "string"},
          "provenance_note": {"type": "string", "minLength": 1},
          "processing_method": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "reason": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "source_box_px": {"$ref": "#/$defs/boxPx"},
          "source_bbox_px": {"$ref": "#/$defs/boxPx"},
          "identity_evidence": {"type": "string", "minLength": 8},
          "source_identity": {"type": "string", "minLength": 8},
          "identity_preserved": {"type": "boolean"},
          "contamination_check": {"$ref": "#/$defs/contaminationCheck"},
          "contamination_checked": {"type": "boolean"},
          "contamination_note": {"type": "string", "minLength": 4},
          "contamination_status": {"enum": ["clean", "passed", "pass", "ok"]}
        },
        "allOf": [
          {"if": {"required": ["processing_method"]}, "then": {"required": ["reason"]}},
          {"if": {"required": ["reason"]}, "then": {"required": ["processing_method"]}},
          {
            "if": {"required": ["source_type"], "properties": {"source_type": {"enum": ["native-object", "svg-reconstructed", "vector-traced", "source-extracted", "image-edited"]}}},
            "then": {"required": ["editability"]}
          },
          {
            "if": {"properties": {"source_type": {"const": "svg-reconstructed"}}, "required": ["source_type"]},
            "then": {
              "required": ["source", "editability"],
              "properties": {"editability": {"const": "svg-image"}}
            }
          },
          {
            "if": {"properties": {"source_type": {"const": "vector-traced"}}, "required": ["source_type"]},
            "then": {
              "required": ["source", "editability"],
              "properties": {"editability": {"const": "svg-image"}}
            }
          },
          {
            "if": {"properties": {"source_type": {"const": "source-extracted"}}, "required": ["source_type"]},
            "then": {
              "required": ["source", "editability"],
              "anyOf": [
                {"required": ["source_box_px"]},
                {"required": ["source_bbox_px"]}
              ],
              "properties": {"editability": {"enum": ["raster-image", "svg-image"]}},
              "allOf": [
                {
                  "anyOf": [
                    {"required": ["identity_evidence"]},
                    {"required": ["source_identity"]},
                    {"required": ["identity_preserved"]}
                  ]
                },
                {
                  "anyOf": [
                    {"required": ["contamination_check"]},
                    {"required": ["contamination_checked"]},
                    {"required": ["contamination_status"]}
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "formula_inventory": {"type": "array"},
    "image2ppt_region_decomposition": {"type": "object"}
  },
  "$defs": {
    "sourceType": {
      "enum": [
        "native-object",
        "svg-reconstructed",
        "vector-traced",
        "source-extracted",
        "image-edited",
        "latex-rendered-formula",
        "asset-sheet-separated",
        "imagegen",
        "user-provided",
        "user-approved-rasterization"
      ]
    },
    "editability": {
      "enum": ["native-object", "svg-image", "raster-image"]
    },
    "boxPx": {
      "type": "array",
      "prefixItems": [
        {"type": "number", "minimum": 0},
        {"type": "number", "minimum": 0},
        {"type": "number", "exclusiveMinimum": 0},
        {"type": "number", "exclusiveMinimum": 0}
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "contaminationCheck": {
      "type": "object",
      "required": ["passed", "observation"],
      "properties": {
        "passed": {"const": true},
        "observation": {"type": "string", "minLength": 4},
        "note": {"type": "string", "minLength": 4}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
